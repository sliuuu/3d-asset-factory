HUB_API_TOKEN=change-me
POSTGRES_PASSWORD=change-me
HUB_DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub

# The live DGX Hunyuan3D (gradio_app.py) is set in compose.yaml (HUB_HUNYUAN_GRADIO_URL).
# Alternative: a Hunyuan3D server running Tencent api_server.py. Set to its host:port, e.g. http://dgx.ailab.lan:8081
HUB_HUNYUAN_API_URL=
# Checkpoint it serves, recorded on every run (e.g. tencent/Hunyuan3D-2.1 or tencent/Hunyuan3D-2)
HUB_HUNYUAN_API_MODEL=tencent/Hunyuan3D-2.1
